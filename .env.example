VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL des endpoints /api.
# Web / PWA : laisser VIDE (chemins relatifs, même origine).
# Build app native (Capacitor) : mettre l'URL absolue du déploiement,
# ex: VITE_API_BASE_URL=https://ton-app.vercel.app
VITE_API_BASE_URL=

# Mode demo : true = BDD Supabase desactivee, pas de connexion, donnees en localStorage
VITE_DEMO_MODE=false
